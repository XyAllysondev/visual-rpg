# Build de produção (npm run build) — consumido em src/App.jsx (const API_BASE).
# URL do backend serverless (Vercel), agora com domínio próprio em vez de *.vercel.app.
REACT_APP_API_URL=https://api.playnexusrpg.com

# ── O código-fonte NÃO vai para produção ────────────────────────────────────
# Sem esta linha o CRA publica `main.*.js.map` junto do bundle, e o arquivo
# responde 200 no domínio público — o React original, nomes de variável,
# comentários e a lógica de negócio inteira. Este build gerava 8 desses.
GENERATE_SOURCEMAP=false

# ── Avisos de lint não derrubam o build ─────────────────────────────────────
# A Vercel define `CI=true` sozinha, e o CRA promove todo warning do ESLint a
# erro quando `CI` está setada — foi o que quebrou o deploy do commit 422b2f4
# (~60 avisos, todos dívida técnica pré-existente). Mesma decisão que o
# .github/workflows/ci.yml já tinha tomado para o build do GitHub Actions.
#
# Mora AQUI, e não no painel da Vercel, porque `.env.production` é lido em TODO
# `npm run build`: cobre o build local, o CI e a Vercel de uma vez só, e fica
# versionado em vez de depender de configuração manual no dashboard.
#
# NÃO é conserto da dívida — só para de escondê-la atrás de um deploy vermelho.
# Os `no-dupe-keys` em src/App.jsx (chave `background` duplicada) são bugs de
# verdade e continuam lá.
DISABLE_ESLINT_PLUGIN=true
