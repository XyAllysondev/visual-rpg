# Build de produção (npm run build) — consumido em src/App.jsx (const API_BASE).
# URL do backend serverless (Vercel), agora com domínio próprio em vez de *.vercel.app.
REACT_APP_API_URL=https://api.playnexusrpg.com

# ── O código-fonte NÃO vai para produção (spec 0036 · AC-8) ──────────────────
# Sem esta linha o CRA publica `main.*.js.map` junto do bundle, e o arquivo
# responde 200 em https://playnexusrpg.com — 6,5 MB com o React original,
# nomes de variável, comentários e a lógica de negócio inteira.
#
# Mora AQUI, e não no craco.config.js nem no CI, porque `.env.production` é
# lido em TODO `npm run build`: cobre o build local, o predeploy do Firebase
# (firebase.json:3), o GitHub Actions (ci.yml) e a Vercel de uma vez só.
GENERATE_SOURCEMAP=false
