rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users (perfil + plano) ─────────────────────────────────────────────────
    // plan/subscribedSystems são escritos APENAS pelo backend (service account não passa
    // pelas rules). Cliente não pode se dar plano (spec 0004 AC-1).
    //
    // O RESTO DO DOCUMENTO É PREFERÊNCIA DO DONO e ele escreve à vontade: `musicLinks`
    // (App.jsx) e `mapaPadraoDispensado` (spec 0028 AC-13 — a marca de "não me ofereça
    // mais o mapa padrão") entram por `setDoc({merge:true})` e passam nas duas regras
    // abaixo sem exceção nova: `create` só barra `subscribedSystems` e `plan != 'free'`,
    // e `update` só congela esses mesmos dois campos. Se um dia a preferência precisar
    // de mais campos, ela continua cabendo aqui — NÃO afrouxe a lista congelada.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['subscribedSystems'])
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free');
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'subscribedSystems']);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // ── Characters (fichas do usuário) ───────────────────────────────────────
      match /characters/{charId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Assets (biblioteca de mapa do usuário — spec 0013 / ADR 0006 §4) ──────
      // Coleção do próprio usuário, reutilizável entre campanhas. Só o dono lê/escreve;
      // imagens colocadas na cena são copiadas para a campanha (jogadores nunca leem daqui).
      match /assets/{assetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Mapas-múndi · ATELIÊ (spec 0028 / AC-1) ──────────────────────────────
      // O MOLDE do mapa-múndi é privado do mestre: nós ocultos, trilhas secretas,
      // `gmNotes` e `gmText` moram aqui. Só o dono lê e escreve — jogadores nunca
      // leem daqui, como em `assets` acima.
      //
      // ISTO É O MECANISMO DE SEGREDO INTEIRO, não uma trava a mais: o AC-1 exige
      // que um jogador com DevTools não consiga obter nome, posição ou descrição de
      // nó `hidden` inspecionando o tráfego real. Isso só se sustenta porque o dado
      // NUNCA sai deste caminho. O que a mesa enxerga é cópia criada no ato da
      // revelação, em `campaigns/{cid}/worldmaps/...` (F4).
      //
      // NÃO abra leitura aqui para membro de campanha por conveniência — seria
      // vazar o molde inteiro e derrubar o AC-1.
      match /worldmaps/{mapId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // nodes / edges / events (F2 em diante). Regra explícita porque
        // subcoleção NÃO herda a regra do documento pai.
        match /{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // ── Campaigns ─────────────────────────────────────────────────────────────
    match /campaigns/{campaignId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.masterId == request.auth.uid
        && request.resource.data.members.hasAll([request.auth.uid]);

      allow update: if request.auth != null
        && resource.data.masterId == request.auth.uid;

      // Membro existente pode atualizar apenas members/memberNames
      allow update: if request.auth != null
        && resource.data.members.hasAny([request.auth.uid])
        && onlyUpdatingFields(['members', 'memberNames']);

      // Qualquer usuário autenticado pode se ADICIONAR à campanha (entrar com código)
      allow update: if request.auth != null
        && !resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.hasAll([request.auth.uid])
        && onlyUpdatingFields(['members', 'memberNames']);

      allow delete: if request.auth != null
        && resource.data.masterId == request.auth.uid;

      // ── Messages ─────────────────────────────────────────────────────────────
      match /messages/{messageId} {
        allow read: if request.auth != null && isMember(campaignId);
        allow create: if request.auth != null
          && isMember(campaignId)
          && (
            request.resource.data.userId == request.auth.uid
            || request.resource.data.userId == "system"
          );
        allow delete: if request.auth != null
          && (
            resource.data.userId == request.auth.uid
            || isMaster(campaignId)
          );
        allow update: if false;
      }

      // ── Typing indicators ────────────────────────────────────────────────────
      match /typing/{userId} {
        allow read:  if request.auth != null && isMember(campaignId);
        allow write: if request.auth != null && request.auth.uid == userId && isMember(campaignId);
      }

      // ── Shared Sheets ────────────────────────────────────────────────────────
      match /sharedSheets/{sheetId} {
        allow read: if request.auth != null && isMember(campaignId);
        allow create: if request.auth != null
          && isMember(campaignId)
          && request.resource.data.ownerId == request.auth.uid;
        allow delete: if request.auth != null
          && (
            resource.data.ownerId == request.auth.uid
            || isMaster(campaignId)
          );
        allow update: if request.auth != null
          && isMember(campaignId)
          && (
            // Dono sempre pode atualizar
            resource.data.ownerId == request.auth.uid
            // Mestre pode editar se allowMasterEdit != false (default true)
            || (isMaster(campaignId) && resource.data.characterData.allowMasterEdit != false)
            // Qualquer membro da campanha pode editar se allowAnyEdit == true
            || resource.data.characterData.allowAnyEdit == true
          );
      }

      // ── Mapa da campanha (VTT) v2 — spec 0009 / ADR 0006 ─────────────────────
      // Docs da coleção map: state (ponteiro), cenas s_* (meta), img_* (imutáveis),
      // live_{uid} (canal efêmero). Escrita geral só do mestre; membro escreve apenas
      // o próprio live_{uid}.
      match /map/{docId} {
        allow read: if request.auth != null && isMember(campaignId);
        allow write: if request.auth != null && isMaster(campaignId);
        allow write: if request.auth != null && isMember(campaignId)
          && docId == 'live_' + request.auth.uid;

        // Elementos da cena em docs próprios — jogador gated pelas permissions da cena
        // (dormente até a spec 0010; mestre tem write total).
        match /elements/{elId} {
          allow read: if request.auth != null && isMember(campaignId);
          allow write: if request.auth != null && isMaster(campaignId);
          allow create: if request.auth != null && isMember(campaignId)
            && request.resource.data.ownerId == request.auth.uid
            && layerPerm(campaignId, docId, request.resource.data.layerId, 'create') == true;
          allow update: if request.auth != null && isMember(campaignId)
            && resource.data.ownerId == request.auth.uid
            && layerPerm(campaignId, docId, resource.data.layerId, 'update') == 'owner'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x', 'y', 'rotation']);
          allow delete: if request.auth != null && isMember(campaignId)
            && resource.data.ownerId == request.auth.uid
            && layerPerm(campaignId, docId, resource.data.layerId, 'delete') == 'owner';
        }
      }

      // ── Mapa-múndi · MESA (spec 0028 / F4 · AC-1, AC-7, AC-10) ───────────────
      // A instância é o molde levado a ESTA mesa: guarda o progresso do grupo e
      // NADA do que o mestre escondeu. O molde (com `gmNotes`, trilhas secretas e
      // nós ocultos) continua só em `users/{uid}/worldmaps/**` — o bloco lá em
      // cima nega a qualquer outro uid, e é isso que sustenta o AC-1. Aqui embaixo
      // só chega o que já foi revelado, em documentos criados no ato da revelação.
      //
      // Subcoleção NÃO herda a regra do documento pai: cada uma é declarada.
      //
      // ═══ O TETO DE 20 ACCESS CALLS — leia antes de trocar qualquer condição ═══
      //
      // O Firestore permite no máximo 20 `get()`/`exists()` por escrita em LOTE, e
      // o orçamento é do lote inteiro, não de cada documento. `isMaster()` é um
      // `get()`. Uma revelação de região grava dezenas de documentos em `revealed/`
      // de uma vez: com a regra baseada em `get()`, o lote INTEIRO é negado e nada
      // é revelado. Não é teoria — foi exatamente o que aconteceu com o mundo demo
      // da Forja no bloco `worlds/` (~48 documentos), que nascia vazio.
      //
      // A saída é a mesma de lá: denormalizar. Aqui a denormalização está no ID da
      // instância, que é `{uidDoMestre}~{mapId}` (ver `WorldMap/mesaStore.js`,
      // `idDaInstancia`). `donoDaInstancia()` compara o prefixo do id com
      // `request.auth.uid` — ZERO access calls — e o `||` curto-circuita antes de
      // chegar em `isMaster()`. Um lote de 300 revelações custa 0 leituras de regra.
      //
      // Isso é seguro porque o documento RAIZ da instância só nasce por `isMaster()`
      // (escrita de documento único: 1 access call, muito abaixo do teto). Logo, só
      // existe instância cujo id nomeia o mestre da campanha, e só o uid nomeado no
      // id escreve na subárvore dela. O `isMaster()` fica como segunda alternativa
      // para o caso de a mesa trocar de mestre.
      //
      // O que sobra, dito por extenso: um membro qualquer consegue escrever numa
      // subárvore cujo id comece com o PRÓPRIO uid — mas o documento raiz dela
      // nunca existe (só `isMaster()` cria), então nenhuma consulta a devolve e
      // nenhuma tela a mostra. É lixo invisível no espaço dele, não acesso ao
      // mapa do grupo: a instância de verdade tem o uid do MESTRE no id, e a
      // escrita dele ali continua negada.
      //
      // Trocar o separador `~` aqui obriga a trocar `SEPARADOR_DA_INSTANCIA` no
      // `mesaStore.js` no mesmo commit — os dois leem o mesmo id.
      match /worldmaps/{instanceId} {
        allow read: if request.auth != null && isMember(campaignId);
        allow write: if request.auth != null && isMaster(campaignId);

        // O que já foi revelado: nós, trilhas e o texto público dos eventos.
        // É a única fonte do mapa para o jogador — o que não está aqui não existe
        // para ele nem no tráfego de rede.
        match /revealed/{docId} {
          allow read: if request.auth != null && isMember(campaignId);
          allow write: if request.auth != null
            && (donoDaInstancia(instanceId) || isMaster(campaignId));
        }

        // Cópia da ilustração de fundo (plano B do ADR-0008: base64 no Firestore).
        // Existe porque o jogador não alcança o documento do ateliê onde a arte
        // original mora — sem a cópia, o mapa chegaria à mesa sem ilustração.
        match /media/{docId} {
          allow read: if request.auth != null && isMember(campaignId);
          allow write: if request.auth != null
            && (donoDaInstancia(instanceId) || isMaster(campaignId));
        }

        // Onde o grupo está, o relógio e os suprimentos.
        // O JOGADOR também escreve aqui — mas só o movimento (AC-8: "o jogador
        // clica em nó adjacente por trilha revelada para viajar"). A lista de
        // campos é o espelho de `CAMPOS_DO_MOVIMENTO` no `mesaStore.js`.
        match /party/{docId} {
          allow read: if request.auth != null && isMember(campaignId);
          allow write: if request.auth != null
            && (donoDaInstancia(instanceId) || isMaster(campaignId));
          allow update: if request.auth != null && isMember(campaignId)
            && onlyUpdatingFields(['currentNodeId', 'x', 'y', 'movedBy', 'updatedAt']);
        }

        // A máscara de névoa daquele grupo (formato da F3, `model/fogMask.js`).
        match /fog/{docId} {
          allow read: if request.auth != null && isMember(campaignId);
          allow write: if request.auth != null
            && (donoDaInstancia(instanceId) || isMaster(campaignId));
        }

        // Painel do mestre: eventos disparados, encontro aguardando decisão,
        // rascunho. O jogador NEM LÊ — não há `isMember` nenhum nesta linha, e
        // isso é proposital (design §3).
        match /gm/{docId} {
          allow read, write: if request.auth != null
            && (donoDaInstancia(instanceId) || isMaster(campaignId));
        }
      }
    }

    // ── Worlds (Forja do Mestre — spec 0027) ─────────────────────────────────
    // O mundo é privado do mestre que o criou: só o dono lê e escreve, e ninguém
    // pode transferir a posse editando `ownerUid`. Wiki, conexões e pastas herdam
    // o dono pelo documento raiz. (Compartilhar mundo por link é a Fase 8 e vai
    // exigir regra própria — não abra leitura pública aqui antes disso.)
    match /worlds/{worldId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // entities / connections / folders (e o que a suíte adicionar nas próximas fases).
      //
      // LEITURA usa `isWorldOwner()` (um `get()`): a consulta é de coleção inteira,
      // e a regra não consegue inspecionar documento a documento nesse caso.
      //
      // ESCRITA usa o `ownerUid` gravado no PRÓPRIO documento, sem `get()`. Motivo:
      // o Firestore permite no máximo 20 "access calls" por escrita em lote, e o
      // mundo demo grava ~48 documentos de uma vez — com `get()` por documento o
      // lote inteiro era negado e o mundo nascia vazio. O `||` curto-circuita, então
      // documentos legados (sem `ownerUid`) ainda são editáveis via `get()`.
      match /{document=**} {
        allow read: if request.auth != null && isWorldOwner(worldId);
        allow create: if request.auth != null
          && (request.resource.data.ownerUid == request.auth.uid || isWorldOwner(worldId));
        allow update: if request.auth != null
          && (resource.data.get('ownerUid', '') == request.auth.uid || isWorldOwner(worldId));
        allow delete: if request.auth != null
          && (resource.data.get('ownerUid', '') == request.auth.uid || isWorldOwner(worldId));
      }
    }

    // ── Public Sheets (fichas compartilháveis por link, sem login) ───────────
    match /publicSheets/{charId} {
      allow read: if true;
      // Dono obrigatório na criação; docs legados sem ownerUid podem ser
      // reivindicados pelo primeiro editor autenticado (retrocompat, spec 0004 AC-3).
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || !('ownerUid' in resource.data))
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || !('ownerUid' in resource.data));

      match /pendingEdits/{editId} {
        allow read: if true;
        // Sugestões continuam abertas (by design); resolver é só do dono da ficha.
        allow create: if true;
        allow update, delete: if request.auth != null
          && (
            !('ownerUid' in get(/databases/$(database)/documents/publicSheets/$(charId)).data)
            || get(/databases/$(database)/documents/publicSheets/$(charId)).data.ownerUid == request.auth.uid
          );
      }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isMember(campaignId) {
      return request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.members;
    }

    function isMaster(campaignId) {
      return request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.masterId;
    }

    // Dono da instância do mapa-múndi na mesa (spec 0028 F4), lido do PRÓPRIO id
    // do documento: `{uidDoMestre}~{mapId}`. **Zero access calls** — é o que faz
    // um lote de dezenas de revelações caber no teto de 20 `get()` por escrita em
    // lote. Ver o bloco `campaigns/{id}/worldmaps` para o porquê por extenso.
    function donoDaInstancia(instanceId) {
      return instanceId.split('~')[0] == request.auth.uid;
    }

    // Dono do mundo da Forja do Mestre (spec 0027) — lido do documento raiz.
    function isWorldOwner(worldId) {
      return request.auth.uid == get(/databases/$(database)/documents/worlds/$(worldId)).data.ownerUid;
    }

    function onlyUpdatingFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Permissão da camada declarada no doc da cena (spec 0009 / ADR 0006 §6).
    // Devolve o valor cru (true/'owner'/'all'/...) ou false se não configurada.
    function layerPerm(campaignId, sceneId, layerId, action) {
      let perms = get(/databases/$(database)/documents/campaigns/$(campaignId)/map/$(sceneId)).data.permissions;
      return (layerId in perms && action in perms[layerId]) ? perms[layerId][action] : false;
    }
  }
}
